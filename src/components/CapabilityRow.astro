---
interface Props {
  index: number;
  title: string;
  text: string;
}
const { index, title, text } = Astro.props;
---
<li class="cap" data-reveal style={`--reveal-i:${index % 3}`}>
  <span class="cap__num" aria-hidden="true">{String(index).padStart(2, "0")}</span>
  <div class="cap__body">
    <h3 class="cap__title">{title}</h3>
    <p class="cap__text">{text}</p>
  </div>
</li>

<style>
  .cap {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 16px;
    padding: 32px 0 34px;
    border-bottom: 1px solid var(--line-light);
  }
  .cap::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    height: 2px;
    width: 0;
    background: var(--copper);
    transition: width 500ms var(--ease);
  }
  .cap:hover::before,
  .cap:focus-within::before {
    width: 100%;
  }
  .cap__num {
    padding-top: 6px;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--copper-ink);
  }
  .cap__title {
    font-size: var(--step-h3);
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition: transform 300ms var(--ease);
  }
  .cap:hover .cap__title {
    transform: translateX(6px);
  }
  .cap__text {
    margin-top: 12px;
    max-width: 58ch;
    color: var(--text);
  }
  @media (max-width: 480px) {
    .cap {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
  }
</style>
