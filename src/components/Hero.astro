---
import Button from "./Button.astro";
import AlignmentVisual from "./AlignmentVisual.astro";
import { hero, CHALLENGE_MAIL } from "../content/site";
---
<section class="hero on-dark" id="top" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title" class="hero__title headline-lines">
        {hero.headline.map((l) => <span>{l}</span>)}
      </h1>
      <p class="hero__body">{hero.body}</p>
      <div class="hero__actions">
        <Button href={CHALLENGE_MAIL} tone="dark">{hero.cta}</Button>
        <Button href={hero.secondary.href} variant="text" tone="dark">{hero.secondary.label}</Button>
      </div>
      <p class="hero__note">{hero.note}</p>
    </div>
    <div class="hero__visual">
      <AlignmentVisual />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(120% 80% at 85% 20%, rgba(185, 121, 79, 0.07), transparent 60%),
      linear-gradient(180deg, var(--charcoal-deep) 0%, var(--charcoal) 100%);
    padding-top: calc(96px + clamp(48px, 9vh, 112px));
    padding-bottom: clamp(64px, 10vh, 128px);
    min-height: min(100svh, 980px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  .hero__copy {
    position: relative;
    z-index: 1;
  }
  .hero__eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--copper-light);
    max-width: 40ch;
  }
  .hero__title {
    margin-top: 28px;
    font-size: var(--step-h1);
    line-height: 0.98;
    letter-spacing: -0.035em;
    width: max-content;
    max-width: 100%;
  }
  .hero__title span:last-child {
    color: var(--text-2-on-dark);
  }
  .hero__body {
    margin-top: 32px;
    max-width: 52ch;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    color: var(--text-2-on-dark);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 40px;
  }
  .hero__note {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line-dark);
    max-width: 52ch;
    font-size: var(--step-small);
    color: var(--text-2-on-dark);
  }
  /* Desktop: the visual sits to the right, partly behind the headline,
     faded on its left edge so the text always wins. */
  @media (min-width: 1101px) {
    .hero__visual {
      position: absolute;
      z-index: 0;
      top: 50%;
      right: 0;
      width: 46%;
      transform: translateY(-50%);
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 6%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 6%);
    }
    .hero__copy {
      max-width: 820px;
    }
  }
  @media (max-width: 1100px) {
    .hero__visual {
      width: 100%;
      max-width: 520px;
      margin: 8px auto 0;
    }
  }
  @media (max-width: 960px) {
    .hero {
      padding-top: calc(var(--header-h) + 48px);
      min-height: 0;
    }
    .hero__title {
      width: auto;
    }
  }
  @media (max-width: 480px) {
    .hero__actions :global(.btn--primary) {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
