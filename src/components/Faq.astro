---
import type { Faq } from "../content/site";
interface Props {
  items: Faq[];
  label?: string;
  headline: string;
  id?: string;
  tone?: "light" | "deep";
}
const { items, label, headline, id = "faq", tone = "light" } = Astro.props;
---
<section class={`faq section faq--${tone}`} id={id} aria-labelledby={`${id}-title`}>
  <div class="container faq__grid">
    <div class="faq__head">
      {label && <p class="label">{label}</p>}
      <h2 id={`${id}-title`} class="faq__title">{headline}</h2>
    </div>
    <div class="faq__list">
      {items.map((f) => (
        <div class="faq__item">
          <h3 class="faq__q">{f.q}</h3>
          <p class="faq__a">{f.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--ivory);
    border-top: 1px solid var(--line-light);
  }
  .faq--deep {
    background: var(--ivory-deep);
  }
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .faq__head {
    display: grid;
    gap: 24px;
    position: sticky;
    top: calc(var(--header-h) + 48px);
  }
  .faq__title {
    font-size: var(--step-h2);
    max-width: 14ch;
  }
  .faq__list {
    border-top: 1px solid var(--charcoal);
  }
  .faq__item {
    padding: 28px 0 30px;
    border-bottom: 1px solid var(--line-light);
  }
  .faq__q {
    font-size: var(--step-h3);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .faq__a {
    margin-top: 12px;
    max-width: 62ch;
  }
  @media (max-width: 960px) {
    .faq__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .faq__head {
      position: static;
    }
  }
</style>
