---
import Logo from "./Logo.astro";
import { footer, EMAIL, LINKEDIN } from "../content/site";
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Logo tone="light" />
      <p class="site-footer__tagline">{footer.tagline}</p>
    </div>
    <ul class="site-footer__links">
      <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      <li><a href={LINKEDIN} rel="noopener" target="_blank">Founder on LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
    </ul>
    <p class="site-footer__legal">© <span data-year>{year}</span> AIVectrix</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--charcoal-deep);
    border-top: 1px solid var(--line-dark);
    padding-block: 48px;
    font-size: var(--step-small);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: start;
  }
  .site-footer__brand :global(.logo) {
    height: 28px;
    width: auto;
  }
  .site-footer__tagline {
    margin-top: 14px;
    color: var(--text-2-on-dark);
    letter-spacing: 0.02em;
  }
  .site-footer__links {
    display: grid;
    gap: 4px;
    justify-items: end;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ivory);
    text-decoration: underline;
    text-decoration-color: rgba(245, 242, 235, 0.3);
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .site-footer__links a:hover {
    text-decoration-color: var(--copper-light);
  }
  .site-footer__legal {
    grid-column: 1 / -1;
    padding-top: 24px;
    border-top: 1px solid var(--line-dark);
    color: var(--text-2-on-dark);
  }
  @media (max-width: 640px) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .site-footer__links {
      justify-items: start;
    }
  }
</style>
