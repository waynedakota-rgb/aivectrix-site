---
/*
 * DRAFT privacy notice, written by an AI assistant from what the site does
 * today. It is not legal advice. Dakota must review it (ideally with a lawyer)
 * before merging, and update it if analytics, cookies, or forms are added.
 */
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SubpageHero from "../components/SubpageHero.astro";
import { EMAIL, CF_ANALYTICS_TOKEN } from "../content/site";
const analytics = !!CF_ANALYTICS_TOKEN;
import { webPage, breadcrumbs } from "../lib/schema";

const path = "/privacy/";
const title = "Privacy | AIVectrix";
const description = analytics
  ? "How AIVectrix handles your information: no cookies or advertising trackers, cookieless visit statistics, and email used only to reply."
  : "How AIVectrix handles your information: no cookies, no analytics, no tracking. Email you send is used only to reply.";
const updated = "November 14, 2026";
const schema = [webPage(path, title, description), breadcrumbs(path, "Privacy")];
---
<Base title={title} description={description} schema={schema}>
  <Header />
  <main id="main" tabindex="-1">
    <SubpageHero
      eyebrow="Privacy"
      title="Privacy at AIVectrix"
      answer={analytics
        ? "This site doesn’t use cookies, advertising pixels, or cross-site tracking. It counts visits with a cookieless analytics tool. If you email me, I use what you send only to reply and to work with you."
        : "This site doesn’t use cookies, analytics, advertising pixels, or tracking of any kind. If you email me, I use what you send only to reply and to work with you."}
      crumb="Privacy"
    />
    <section class="section legal">
      <div class="container legal__body">
        <p class="legal__updated">Last updated {updated}</p>

        <h2>What this site collects</h2>
        {analytics ? (
          <>
            <p>There are no forms, cookies, advertising pixels, or third-party embeds on aivectrix.com.</p>
            <h2>Visit statistics</h2>
            <p>I use Cloudflare Web Analytics to count visits: which pages are viewed, the referring site, the browser and device type, and the country. It doesn’t use cookies, local storage, or fingerprinting, and it doesn’t follow you across other sites. Cloudflare processes this data under the <a href="https://www.cloudflare.com/privacypolicy/" rel="noopener">Cloudflare Privacy Policy</a>.</p>
          </>
        ) : (
          <p>Nothing directly. There are no forms, cookies, analytics tools, or third-party embeds on aivectrix.com.</p>
        )}

        <h2>Hosting</h2>
        <p>The site is hosted on GitHub Pages. Like most web hosts, GitHub may log technical information such as your IP address when you load a page, for security and to keep the service running. GitHub’s handling of that data is described in the <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">GitHub General Privacy Statement</a>.</p>

        <h2>Email</h2>
        <p>If you write to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>, I receive your name, email address, and whatever you include. I use it to reply, to discuss and deliver work you ask for, and to keep a record of our conversation. I don’t sell it, rent it, or add you to a mailing list.</p>

        <h2>Your choices</h2>
        <p>You can ask me what I hold about you, ask me to correct it, or ask me to delete it. Email <a href={`mailto:${EMAIL}`}>{EMAIL}</a> and I’ll respond within 30 days.</p>

        <h2>Changes</h2>
        <p>If this site starts collecting more, such as through a contact form, this page will be updated first.</p>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    import "../scripts/main";
  </script>
</Base>

<style>
  .legal__body {
    max-width: calc(68ch + var(--gutter) * 2);
    margin-inline: 0;
  }
  .legal__updated {
    font-size: var(--step-small);
    color: var(--text-2);
  }
  .legal h2 {
    margin-top: 48px;
    font-size: var(--step-h3);
  }
  .legal p {
    margin-top: 14px;
  }
  .legal a {
    color: var(--charcoal);
    text-underline-offset: 4px;
    text-decoration-color: var(--copper);
  }
</style>
