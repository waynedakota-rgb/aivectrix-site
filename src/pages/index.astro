---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Invitation from "../components/Invitation.astro";
import Approach from "../components/Approach.astro";
import Capabilities from "../components/Capabilities.astro";
import AIFeature from "../components/AIFeature.astro";
import Experience from "../components/Experience.astro";
import Founder from "../components/Founder.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Faq from "../components/Faq.astro";
import { faq, seo } from "../content/site";
import { webPage, faqPage } from "../lib/schema";
const schema = [webPage("/", seo.title, seo.description), faqPage("/", faq.items)];
---
<Base schema={schema}>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Invitation />
    <Approach />
    <Capabilities />
    <AIFeature />
    <Experience />
    <Founder />
    <Faq items={faq.items} label={faq.label} headline={faq.headline} />
    <Contact />
  </main>
  <Footer />
  <script>
    import "../scripts/main";
  </script>
</Base>
